# TrustPass environment configuration
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any file containing real secrets.

# The connected Skool profile email shown in the top bar.
# Rendered in the client UI, so it must use the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SKOOL_PROFILE_EMAIL="you@example.com"

# --- Server-only secrets (never expose with NEXT_PUBLIC_) ---
# Postgres connection string (Neon). Server-side only.
# DATABASE_URL="postgres://user:password@host/db?sslmode=require"

# Better Auth secret. Generate with: openssl rand -base64 32
# BETTER_AUTH_SECRET=""
# BETTER_AUTH_URL="http://localhost:3000"
